#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
if [[ -f .tooling/pipeline-android/env.sh ]]; then source .tooling/pipeline-android/env.sh; fi
: "${ANDROID_HOME:?Android SDK required}"
ndk="$ANDROID_HOME/ndk/29.0.14206865/toolchains/llvm/prebuilt/linux-x86_64/bin"
export CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER="$ndk/aarch64-linux-android29-clang"
export CC_aarch64_linux_android="$CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER"
export AR_aarch64_linux_android="$ndk/llvm-ar"
cargo build --locked --release --target aarch64-linux-android -p phoneboost-core-jni --features experimental-multicore
library="${CARGO_TARGET_DIR:-target}/aarch64-linux-android/release/libphoneboost_core_jni.so"
mkdir -p .work/multicore/jniLibs/arm64-v8a
readelf --dyn-syms --wide "$library" > .work/multicore/native-symbols.txt
grep -q Java_org_phoneboost_app_MulticoreNative_configure .work/multicore/native-symbols.txt
cp "$library" .work/multicore/jniLibs/arm64-v8a/
gradle --no-daemon -p android -PphoneboostMulticoreSpike=true :app:assembleDebug :app:lintDebug
test -f android/app/build-multicore/outputs/apk/debug/app-debug.apk
python3 - <<'PY'
import zipfile
with zipfile.ZipFile('android/app/build-multicore/outputs/apk/debug/app-debug.apk') as apk:
    dex = b''.join(apk.read(name) for name in apk.namelist() if name.endswith('.dex'))
    assert b'MulticoreProfileReceiver' in dex, 'experimental Kotlin receiver missing from APK'
    assert b'probe_token' in dex, 'current measurement protocol missing from APK'
    native = apk.read('lib/arm64-v8a/libphoneboost_core_jni.so')
    assert b'Java_org_phoneboost_app_MulticoreNative_configure' in native
PY
printf '%s\n' 'EXPERIMENT ONLY: org.phoneboost.app.multicore; no physical claim from this build.'
